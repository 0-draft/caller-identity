{
  // Matches the rules used across these repositories: long lines are fine
  // because paragraphs are one line each, and duplicate headings are allowed
  // because the English and Japanese READMEs mirror each other.
  "config": {
    "MD013": false,
    "MD024": false,
    "MD036": false,
    "MD041": false,
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", "dist/**"],
}
